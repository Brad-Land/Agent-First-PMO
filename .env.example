# Where the graph is stored (SQLite file)
PMO_DB=pmo.db

# Which extractor to use: heuristic (offline, default), bedrock, or openai (any OpenAI-compatible server, e.g. a local Ollama)
PMO_EXTRACTOR=heuristic

# Amazon Bedrock (needs: pip install -e ".[bedrock]" and AWS credentials in your usual AWS config)
PMO_BEDROCK_MODEL_ID=
AWS_REGION=us-east-1

# OpenAI-compatible endpoint (local or bring-your-own model)
PMO_OPENAI_BASE_URL=http://localhost:11434/v1
PMO_OPENAI_MODEL=llama3.1
PMO_OPENAI_API_KEY=
